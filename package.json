{
  "name": "gmodwiki",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "node --no-warnings=ExperimentalWarning --loader ts-node/esm ./build/index.ts",
    "astrobuild": "astro build",
    "preview": "astro preview",
    "get_used_mdis": "rg -Io \"mdi-[\\w-]+\" ./build/cache/ | sort | uniq | sed 's/.*/\".&\",/'",
    "build_categories": "node --no-warnings=ExperimentalWarning --trace-uncaught --trace-warnings --loader ts-node/esm ./build/modules/categories/build_categories.ts",
    "clear_recent_changes": "node --no-warnings=ExperimentalWarning --trace-uncaught --trace-warnings --loader ts-node/esm ./build/modules/clear_recent_changes.ts",
    "embeddings": "node --no-warnings=ExperimentalWarning --loader ts-node/esm ./build/build_embeddings_local.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/internal-helpers": "^0.7.4",
    "@frsource/is-animated": "^1.0.5",
    "@playform/compress": "^0.2.0",
    "@types/html-minifier": "^4.0.6",
    "@types/minify": "^9.1.4",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.15.5",
    "astro": "^5.16.3",
    "bottleneck": "^2.19.5",
    "chalk": "^5.3.0",
    "cheerio": "^1.1.2",
    "gmod-wiki-scraper": "github:NullEnt1ty/gmod-wiki-scraper",
    "html-minifier-next": "^4.16.3",
    "ky": "^1.14.1",
    "sharp": "^0.34.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "@astrojs/node": "^9.5.1",
    "@huggingface/transformers": "^3.8.1",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "downloadjs": "^1.4.7",
    "fetch-to-node": "^2.1.0",
    "html-to-image": "^1.11.13",
    "pg": "^8.16.0",
    "vite-plugin-image-optimizer": "^2.0.3",
    "zod": "^3.25.76"
  }
}
