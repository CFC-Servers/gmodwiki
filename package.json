{
  "name": "gmodwiki",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "node --no-warnings=ExperimentalWarning --loader ts-node/esm ./build/index.ts",
    "astrobuild": "astro build",
    "preview": "astro preview",
    "worker:dev": "wrangler dev",
    "worker:deploy": "BUILD_ENV=production astro build && rm -fv dist/client/search_index.json dist/client/embeddings.bin dist/client/embeddings_manifest.json && wrangler deploy",
    "get_used_mdis": "rg -Io \"mdi-[\\w-]+\" ./build/cache/ | sort | uniq | sed 's/.*/\".&\",/'",
    "upload_caches": "/bin/bash ./build/modules/upload_caches.sh",
    "download_caches": "/bin/bash ./build/modules/download_caches.sh",
    "upload_categories": "/bin/bash ./build/modules/categories/upload_categories.sh",
    "build_categories": "node --no-warnings=ExperimentalWarning --trace-uncaught --trace-warnings --loader ts-node/esm ./build/modules/categories/build_categories.ts",
    "clear_recent_changes": "node --no-warnings=ExperimentalWarning --trace-uncaught --trace-warnings --loader ts-node/esm ./build/modules/clear_recent_changes.ts",
    "clear_cloudflare_cache": "node --no-warnings=ExperimentalWarning --trace-uncaught --trace-warnings --loader ts-node/esm ./build/modules/clear_cloudflare_cache.ts",
    "vectorize_sync": "node --no-warnings=ExperimentalWarning --loader ts-node/esm ./build/modules/vectorize_sync.ts",
    "embeddings": "node --no-warnings=ExperimentalWarning --loader ts-node/esm ./build/build_embeddings_local.ts",
    "embeddings:publish": "npm run embeddings && npm run vectorize_sync",
    "mcp:deploy": "npm --prefix semantic/mcp/hosted run deploy",
    "mcp:publish": "npm run embeddings:publish && npm run mcp:deploy",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261124.2",
    "@frsource/is-animated": "^1.0.5",
    "@playform/compress": "^0.2.5",
    "@types/html-minifier": "^4.0.6",
    "@types/minify": "^9.1.4",
    "@types/node": "^25.0.3",
    "astro": "^7.4.13",
    "bottleneck": "^2.19.5",
    "chalk": "^5.3.0",
    "cheerio": "^1.1.2",
    "html-minifier-next": "^4.16.3",
    "ky": "^1.14.1",
    "sharp": "^0.35.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.168.0"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.9",
    "@astrojs/node": "^11.1.14",
    "@huggingface/transformers": "^3.8.1",
    "downloadjs": "^1.4.7",
    "html-to-image": "^1.11.13",
    "zod": "^4.6.7"
  },
  "overrides": {
    "sharp": "$sharp",
    "svgo": "^4.1.0",
    "deepmerge-ts": "^8.0.2"
  }
}
