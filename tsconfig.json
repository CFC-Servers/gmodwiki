{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": [
    "dist",
    "build/fragments",
    "semantic/mcp/hosted",
    "semantic/mcp/local"
  ],
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "WebWorker"],
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "types": [
      "@cloudflare/workers-types"
    ],
    "baseUrl": ".",
    "paths": {
        "@layouts/*": ["src/layouts/*"],
        "@lib/*": ["src/lib/*"]
    }
  },
  "ts-node": {
    "transpileOnly": true,
    "compilerOptions": {
      "moduleResolution": "node"
    }
  }
}
